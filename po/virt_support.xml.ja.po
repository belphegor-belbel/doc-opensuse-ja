#: virt_support.xml:149
#, no-c-format
msgid "&power;"
msgstr ""

#. Tag: para
#: virt_support.xml:150
#, no-c-format
msgid ""
"Running &kvm; or &xen; hypervisors on the &power; platform is not supported."
msgstr ""

