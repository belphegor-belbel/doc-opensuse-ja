#. Tag: title
#: virt_support.xml:458
#, no-c-format
msgid "EFI exception on &sls; 12 SP5 &kvm; hosts"
msgstr ""

#. Tag: para
#: virt_support.xml:459
#, no-c-format
msgid ""
"Installing a &sls; 15 SP7 UEFI guest on a &sls; 12 SP5 &kvm; host using a "
"network-based installation (for example, <command>virt-install</command> "
"with the <option>--location</option> option) can fail with an EFI exception "
"before the installation starts. This is caused by an incompatibility between "
"the iPXE ROM shipped with &sls; 12 SP5's &qemu; packages and the EFI stub "
"handover code in newer guest kernels."
msgstr ""

#. Tag: para
#: virt_support.xml:467
#, no-c-format
msgid ""
"To work around this issue, disable the iPXE ROM on the guest's network "
"interface. In the &libvirt; domain XML, add <literal>&lt;rom bar='off'/&gt;</"
"literal> to the <literal>&lt;interface&gt;</literal> element. Alternatively, "
"when using <command>virt-install</command> , add <literal>rom_bar=off</"
"literal> to the <option>--network</option> option."
msgstr ""

